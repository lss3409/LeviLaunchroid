<?xml version="1.0" encoding="utf-8"?>
<!-- 联机页（v498 重设计）：状态卡 / 房间卡 / 加入卡 / 创建卡 / 中转设置 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="48dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- 头部 -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_nav_online"
            android:contentDescription="@string/nav_online"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/misans"
            android:text="@string/online_title"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/misans"
            android:gravity="center"
            android:text="@string/online_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 连接状态卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_rounded_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/online_state_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_state_dot_idle" />

                <TextView
                    android:id="@+id/online_state_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/misans"
                    android:text="@string/online_state_idle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/online_disconnect_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="@color/error"
                    android:fontFamily="@font/misans"
                    android:paddingHorizontal="14dp"
                    android:text="@string/online_disconnect"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/online_state_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 我的房间卡（创建后显示） -->
        <LinearLayout
            android:id="@+id/online_room_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_rounded_card"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/online_my_room"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/online_room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:text="@string/online_room_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/online_copy_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="@font/misans"
                    android:text="@string/online_copy_code"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/online_share_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="@font/misans"
                    android:text="@string/online_share_code"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 加入房间卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/online_join_section"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_edit_text"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <!-- P/ 前缀为渲染层文本，不参与输入——手输前缀不会与数据位混淆 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="P/"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/online_code_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/misans"
                    android:hint="@string/online_code_hint"
                    android:inputType="textCapCharacters"
                    android:maxLength="21"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/online_paste_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="@color/divider"
                    android:fontFamily="@font/misans"
                    android:paddingHorizontal="12dp"
                    android:text="@string/online_paste"
                    android:textAllCaps="false"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 实时校验反馈 -->
            <TextView
                android:id="@+id/online_code_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/online_join_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/misans"
                android:text="@string/online_join_button"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 创建房间卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/online_create_section"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/misans"
                android:text="@string/online_create_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/online_create_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/misans"
                android:text="@string/online_create_coming"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 中转服务器设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/online_relay_section"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/online_relay_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="@font/misans"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/online_relay_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="@color/divider"
                android:fontFamily="@font/misans"
                android:paddingHorizontal="14dp"
                android:text="@string/online_relay_edit"
                android:textAllCaps="false"
                android:textColor="@color/on_surface"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
