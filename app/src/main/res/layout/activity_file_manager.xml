<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/fm_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/fm_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface"
            android:contentDescription="@null" />

        <!-- v0.4.90：面包屑路径栏（系统文件管理器同款：点段直接跳转） -->
        <HorizontalScrollView
            android:id="@+id/fm_path_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/fm_path_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/fm_btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/fm_btn_sort"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_sort"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/fm_btn_multi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_multi"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/fm_btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 剪贴板横幅 v0.4.208 已删（用户拍板，粘贴入口走长按气泡/更多菜单） -->

    <!-- 音频播放面板（v669 恢复旧版，默认隐藏） -->
    <LinearLayout
        android:id="@+id/fm_audio_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fm_audio_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_surface" />

        <TextView
            android:id="@+id/fm_audio_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:maxWidth="120dp" />

        <TextView
            android:id="@+id/fm_audio_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/fm_audio_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/fm_audio_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 内容区 -->
    <FrameLayout
        android:id="@+id/fm_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 横屏左侧导航栏 -->
            <LinearLayout
                android:id="@+id/fm_nav_rail"
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp">

                <LinearLayout
                    android:id="@+id/fm_rail_home"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_house"
                        app:tint="@color/on_surface"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/fm_rail_home_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fm_rail_trash"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/on_surface"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/fm_rail_trash_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- v0.4.203：横屏双窗操作（底栏在横屏隐藏，双窗四键放 rail） -->
                <LinearLayout
                    android:id="@+id/fm_rail_dual"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/fm_rail_dual_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/fm_rail_dual_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fm_rail_up"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/on_surface"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/fm_rail_up_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fm_rail_sync"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/on_surface"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/fm_rail_sync_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fm_rail_new"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/on_surface"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/fm_rail_new_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- v0.4.203：左窗格（单窗模式=全屏，双窗模式=左半边） -->
            <LinearLayout
                android:id="@+id/fm_pane_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fm_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fm_trash_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/fm_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 双窗分隔线 -->
            <View
                android:id="@+id/fm_pane_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@color/text_secondary" />

            <!-- v0.4.203：右窗格（双窗模式显示；独立路径栏+列表） -->
            <LinearLayout
                android:id="@+id/fm_pane_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/fm_path_scroll_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:paddingTop="4dp">

                    <LinearLayout
                        android:id="@+id/fm_path_bar_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fm_recycler_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/fm_empty_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 任务进度横幅 -->
        <LinearLayout
            android:id="@+id/fm_task_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/fm_task_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/fm_btn_task_cancel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/on_surface"
                    android:contentDescription="@null" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/fm_task_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="1000" />
        </LinearLayout>
    </FrameLayout>

    <!-- 竖屏底栏 -->
    <LinearLayout
        android:id="@+id/fm_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fm_bottom_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_house"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_bottom_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fm_bottom_trash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_bottom_trash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- v0.4.203：双窗模式底栏（MT 管理器同款）：单/双窗切换、上一级、窗口同步、新建 -->
        <LinearLayout
            android:id="@+id/fm_bottom_dual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/fm_bottom_dual_icon"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/fm_bottom_dual_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fm_bottom_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_bottom_up_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fm_bottom_sync"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sync"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_bottom_sync_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fm_bottom_new"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_bottom_new_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 多选操作条（v0.4.203 MT 化：文字按钮替换 Zalith 贴图） -->
    <LinearLayout
        android:id="@+id/fm_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/fm_btn_sel_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_sel_all"
            android:textSize="14sp"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/fm_btn_sel_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_copy"
            android:textSize="14sp"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/fm_btn_sel_cut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_cut"
            android:textSize="14sp"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/fm_btn_sel_compress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_compress"
            android:textSize="14sp"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/fm_btn_sel_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_delete"
            android:textSize="14sp"
            android:textColor="@color/error" />

        <TextView
            android:id="@+id/fm_btn_sel_props"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_properties"
            android:textSize="14sp"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/fm_btn_sel_exit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/fm_ui_exit_multi"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 内置文本编辑器页（v668，默认隐藏） -->
    <LinearLayout
        android:id="@+id/fm_editor_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/fm_editor_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_editor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="middle"
                android:paddingHorizontal="4dp"
                android:textSize="15sp"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/fm_editor_dirty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingEnd="4dp" />

            <!-- 只读模式开关：睁眼=只读，笔=可编辑（v670） -->
            <ImageView
                android:id="@+id/fm_editor_readonly"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_eye"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/on_surface"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fm_editor_save"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 大文件截断预览提示条（v0.4.142） -->
        <TextView
            android:id="@+id/fm_editor_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="@color/background"
            android:text="@string/fm_editor_preview_notice" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.levimc.launcher.filemanager.ui.FlingEditText
                android:id="@+id/fm_editor_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:typeface="monospace"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingEnd="12dp"
                android:background="@color/background"
                android:scrollbars="vertical"
                android:textIsSelectable="true" />

            <!-- 可拖动触摸热区（v680：系统滚动条负责显示，本区只负责拖动） -->
            <org.levimc.launcher.filemanager.ui.FmEditorScrollBar
                android:id="@+id/fm_editor_scrollbar"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="end" />

            <!-- 大文件加载转圈（v0.4.142） -->
            <ProgressBar
                android:id="@+id/fm_editor_loading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminate="true" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
