<?xml version="1.0" encoding="utf-8"?>
<!-- PRD 布局：地图主屏幕（75%-80%），顶栏/左栏/底栏为悬浮覆盖层，不挤压地图 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 中央地图：占满全屏 -->
    <org.levimc.launcher.ui.views.WorldMapView
        android:id="@+id/world_map_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/world_map_title" />

    <TextView
        android:id="@+id/world_map_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_card"
        android:fontFamily="@font/misans"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:text="@string/world_map_loading"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 坐标 HUD（底部居中） -->
    <TextView
        android:id="@+id/map_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_rounded_card"
        android:fontFamily="@font/misans"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/map_hud_placeholder"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- 顶栏：悬浮覆盖层，默认收起为窄条 -->

    <!-- 烘焙进度 HUD（坐标 HUD 上方；烘焙中可见，完成隐藏） -->
    <TextView
        android:id="@+id/bake_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="46dp"
        android:background="@drawable/bg_rounded_card"
        android:fontFamily="@font/misans"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 顶栏：悬浮覆盖层，默认收起为窄条 -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topbar_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/nbt_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:id="@+id/nbt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:text="@string/dim_overworld"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topbar_chev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:paddingHorizontal="8dp"
                android:text="▼"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 顶栏展开区 -->
        <LinearLayout
            android:id="@+id/topbar_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/map_search"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field_light"
                android:fontFamily="@font/misans"
                android:hint="@string/map_search_hint"
                android:imeActionLabel="@string/search_jump"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/world_dim_overworld"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/misans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="@string/dim_overworld"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/world_dim_nether"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/misans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="@string/dim_nether"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/world_dim_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/misans"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="@string/dim_end"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左栏：悬浮抽屉，默认收起为图标条 -->
    <LinearLayout
        android:id="@+id/leftbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="horizontal">

        <!-- 图标条（wiki/chunkbase 风格：纯图标，文字进抽屉） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <ImageView
                android:id="@+id/lb_info"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/lb_info"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_world"
                app:tint="@color/primary" />

            <ImageView
                android:id="@+id/lb_layers"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/lb_layers"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_layers"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/lb_points"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/lb_points"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_map"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/lb_settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/lb_settings"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 抽屉 body（3 个 Tab） -->
        <ScrollView
            android:id="@+id/leftbar_body"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Tab1 世界信息 -->
                <LinearLayout
                    android:id="@+id/tab_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/lb_info"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_seed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_gamemode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_hardcore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_dead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_player"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_pos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_uuid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/info_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Tab2 图层控制 -->
                <LinearLayout
                    android:id="@+id/tab_layers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/lb_layers"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/layer_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checked="true"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_grid"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/layer_biome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_biome"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/layer_entity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_entity"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/layer_structure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_structure"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />
                    <CheckBox
                        android:id="@+id/layer_slime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_slime"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Tab3 标点管理器 -->
                <LinearLayout
                    android:id="@+id/tab_points"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/lb_points"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/point_search_input"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_field_light"
                        android:fontFamily="@font/misans"
                        android:hint="@string/point_search_hint"
                        android:importantForAutofill="no"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/point_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Tab4 设置 -->
                <LinearLayout
                    android:id="@+id/tab_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/lb_settings"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />                    <CheckBox
                        android:id="@+id/layer_ore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checked="false"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_ore"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/layer_struct_detect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checked="true"
                        android:fontFamily="@font/misans"
                        android:text="@string/layer_struct_detect"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_clear_cache"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:text="@string/btn_clear_cache"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />





                    <!-- 下界专属设置（仅下界维度显示）：
                         y 轴渲染层 + 黑名单，包在分区卡片里 -->
                    <LinearLayout
                        android:id="@+id/nether_settings_group"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rounded_card"
                        android:orientation="vertical"
                        android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/nether_y_title"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/nether_y_seg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nether_y_all"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/nether_y_all"
                            android:textColor="@color/on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/nether_y_top"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/nether_y_top"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/nether_y_mid"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/nether_y_mid"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/nether_y_bottom"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/nether_y_bottom"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 下界剔除方块（黑名单）：看穿下界岩/灵魂沙显示矿物洞穴 -->
                    <TextView
                        android:id="@+id/nether_exclude_btn"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_search_field_light"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/misans"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:text="@string/nether_exclude_title"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 悬浮工具 FAB 菜单 + FAB（底栏） -->
    <LinearLayout
        android:id="@+id/map_tool_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="72dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tool_add_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_add_point"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tool_link_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_link_mode"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tool_ruler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_ruler"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tool_point_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_point_list"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tool_blueprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_blueprint"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tool_voxel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/tool_voxel"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/map_fab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/on_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 数据全屏面板（level.dat 树 / db 条目，覆盖在地图上） -->
    <LinearLayout
        android:id="@+id/data_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/data_panel_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:fontFamily="@font/misans"
                android:text="@string/world_data_title"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 世界信息摘要卡 -->
        <LinearLayout
            android:id="@+id/nbt_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/nbt_summary_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nbt_summary_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/misans"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nbt_edit_leveldat_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_launch_button"
                android:fontFamily="@font/misans"
                android:minHeight="0dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/nbt_edit_leveldat"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 内容区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <!-- v460：世界设置表单（v464 起数据面板只保留这一个内容区：
                 level.dat 树/db 条目浏览已删除，用户要求） -->
            <FrameLayout
                android:id="@+id/nbt_settings_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include
                    android:id="@+id/settings_form"
                    layout="@layout/nbt_settings_pane" />
            </FrameLayout>

            <ProgressBar
                android:id="@+id/nbt_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
