<?xml version="1.0" encoding="utf-8"?>
<!-- 加入房间弹窗（v500）：输入行 + 实时校验 + 连接步骤条 + 状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans"
        android:text="@string/online_join_section"
        android:textColor="@color/on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_edit_text"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:text="P/"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/join_code_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/misans"
            android:hint="@string/online_code_hint"
            android:inputType="textCapCharacters"
            android:maxLength="21"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_paste_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="@color/divider"
            android:fontFamily="@font/misans"
            android:paddingHorizontal="10dp"
            android:text="@string/online_paste"
            android:textAllCaps="false"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/join_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 连接步骤条（动态构建 4 步） -->
    <LinearLayout
        android:id="@+id/join_steps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/join_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_cancel_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/divider"
            android:fontFamily="@font/misans"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_confirm_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:text="@string/online_join_button"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
