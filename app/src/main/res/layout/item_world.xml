<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/world_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_content_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/world_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_world"
            app:shapeAppearanceOverlay="@style/LeviContentThumbnailShape"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <!-- 极限模式红心角标：活着=红心，已死亡=死亡红心，叠在存档图标右下角 -->
        <ImageView
            android:id="@+id/world_hardcore_heart_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_hardcore_heart_alive"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxLines="1"
                android:text="@string/world_name_placeholder"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/world_hardcore_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_hardcore_tag"
                android:text="@string/hardcore_tag"
                android:fontFamily="@font/misans"
                android:textColor="@color/error"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/world_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/world_game_mode_survival_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/world_last_played"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/world_last_played_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/world_seed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/world_edit_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/world_view_map"
        android:padding="9dp"
        android:src="@drawable/ic_map"
        app:tint="@color/on_surface" />

    <ImageButton
        android:id="@+id/world_overflow_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_actions"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/on_surface" />

    <ImageView
        android:id="@+id/world_selection_indicator"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_search_box"
        android:contentDescription="@string/selected"
        android:padding="7dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/primary" />
</LinearLayout>
