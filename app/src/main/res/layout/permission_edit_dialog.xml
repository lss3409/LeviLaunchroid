<?xml version="1.0" encoding="utf-8"?>
<!-- v463：权限编辑弹窗内容（⋮ 菜单「编辑」入口）——只做权限，
     紧凑单屏，复用启动器胶囊样式与既有颜色 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans"
        android:text="@string/nbt_set_permission_level"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/misans"
        android:lineSpacingExtra="1dp"
        android:text="@string/nbt_perm_level_hint"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/caps_perm_0"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_visitor" />

        <TextView
            android:id="@+id/caps_perm_1"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_member" />

        <TextView
            android:id="@+id/caps_perm_2"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_operator" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/misans"
        android:text="@string/nbt_set_player_permission"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/misans"
        android:lineSpacingExtra="1dp"
        android:text="@string/nbt_pperm_level_hint"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/caps_pperm_0"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_visitor" />

        <TextView
            android:id="@+id/caps_pperm_1"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_member" />

        <TextView
            android:id="@+id/caps_pperm_2"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_operator" />

        <TextView
            android:id="@+id/caps_pperm_3"
            style="@style/NbtCapsule"
            android:text="@string/nbt_perm_custom" />
    </LinearLayout>
</LinearLayout>
