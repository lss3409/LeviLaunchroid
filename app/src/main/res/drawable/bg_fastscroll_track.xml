<?xml version="1.0" encoding="utf-8"?>
<!-- v663：track 同为 StateListDrawable；无 state 的 item 会被
     RecyclerView 1.2.1 解析为 null（"without both required drawables"
     崩溃）——必须带 state 属性 -->
