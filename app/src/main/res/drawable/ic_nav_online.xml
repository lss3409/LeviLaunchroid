<?xml version="1.0" encoding="utf-8"?>
<!-- v547：按用户分支贴图 200x200 等比换算到 24 视口重画。
     贴图实际结构：顶部空心节点框 + 主干 + 横梁（两端向下垂短段）
     + 底部左右两个空心方块（此前误画成"三柱到底"，底部方块缺失）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- v548：整体缩放 0.85（以图形中心 12.95,13 为轴）——
       底部方块 22.8 → 21.3，四周留出安全边距，修 tab 里底部被裁切 -->
  <group
      android:scaleX="0.85"
      android:scaleY="0.85"
      android:pivotX="12.95"
      android:pivotY="13">

  <!-- 顶部节点框（空心）：贴图 x90-144 y27-72 → 10.8,3.2 - 17.3,8.6 -->
  <path
      android:pathData="M10.8,3.2h6.5v5.4h-6.5z"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineJoin="round"
      android:fillColor="@android:color/transparent" />

  <!-- 主干：框底中心垂直到横梁（贴图 x103-117 y72-103） -->
  <path
      android:pathData="M13.2,8.6v3.8"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineCap="round" />

  <!-- 横梁：贴图 x45-189 y103-112 → y 取中线 12.9 -->
  <path
      android:pathData="M5.4,12.9h17.3"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineCap="round" />

  <!-- 横梁两端下垂短段：贴图左 x45-58 中心 6.2、右 x167-189 中心 21.4，y112-130 → 12.9-15.6 -->
  <path
      android:pathData="M6.2,12.9v2.7M21.4,12.9v2.7"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineCap="round" />

  <!-- 底部左空心方块：贴图 x27-81 y140-190 → 3.2,16.8 - 9.7,22.8 -->
  <path
      android:pathData="M3.2,16.8h6.5v6h-6.5z"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineJoin="round"
      android:fillColor="@android:color/transparent" />

  <!-- 底部右空心方块：贴图 x123-177 y140-190 → 14.8,16.8 - 21.2,22.8 -->
  <path
      android:pathData="M14.8,16.8h6.4v6h-6.4z"
      android:strokeColor="#000000"
      android:strokeWidth="2"
      android:strokeLineJoin="round"
      android:fillColor="@android:color/transparent" />

  </group>

</vector>
