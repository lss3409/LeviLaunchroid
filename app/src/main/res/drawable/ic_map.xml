<?xml version="1.0" encoding="utf-8"?>
<!-- 地图样式贴图：折角地图 + 路线标记 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/on_surface">

    <!-- 地图主体（折角） -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15,3 L3,6.5 L3,21 L15,17.5 L21,21 L21,6 L15,3 Z" />

    <!-- 折线 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15,3 L15,17.5 L21,21 L21,6 Z" />

    <!-- 左侧折痕 -->
    <path
        android:strokeColor="@android:color/black"
        android:strokeWidth="0.9"
        android:pathData="M15,3 L3,6.5 M3,6.5 L3,21 M15,17.5 L21,21 M21,21 L21,6 L15,3" />

    <!-- 内部路线 -->
    <path
        android:strokeColor="@android:color/black"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6.5,9.5 L9,11.5 L8,14 L11,13 L13,16 M13,16 L12,12.5 L15.5,12" />

    <!-- 定位点 -->
    <path
        android:fillColor="@android:color/black"
        android:pathData="M13,16 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0" />
</vector>
